  {
	filter = /^[0-9]+(,[0-9]+){0,1}$/;
	if(!filter.test(campoToro))
	{
	  msj += "Por favor introduzca un número en el toro.\n";
	}
  }
  band="";
  for(i=0;i <campoMaterial.length;i++)
  {
  	if(campoMaterial[i].checked)
	{
	  band=campoMaterial[i].value;
	}
  }
  if(band=="")
