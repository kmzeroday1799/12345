  }
  else
  {
  	var campoPerfil = document.getElementById('cmbPerfil'+campoTipoPerfil).value;
  }
  if(campoDiametroInterior=="")
  {
  	msj += "Por favor introduzca el diámetro interior.\n";
  }
  else
  {
	filter = /^[0-9]+(,[0-9]+){0,1}$/;
