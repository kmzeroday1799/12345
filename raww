function mostrartabla(capaAMostrar) {
	for (var i = 0, total = capas.length; i < total; i ++)
	{
		if (capaAMostrar-1!=i)
		{
			document.getElementById(capas[i]).style.display = "none";
		}
		else
		{
			document.getElementById(capas[i]).style.display = "block";
		}
	}
}
