  {
	filter = /^[0-9]+(,[0-9]+){0,1}$/;
	if(!filter.test(campoDiametroExterior))
	{
	  msj += "Por favor introduzca un número en el diámetro exterior.\n";
	}
  }
  if(campoToro=="")
  {
  	msj += "Por favor introduzca el toro.\n";
  }
